{
  "name": "kimi-dock",
  "version": "3.4.0",
  "description": "Kimi Dock - desktop dock for Kimi AI (fork of kimi-desktop, uses Kimi Code Plan)",
  "main": "./out/main/index.js",
  "author": "heni <eugene.krokhalev@gmail.com>",
  "homepage": "https://github.com/heni/kimi-dock",
  "repository": "heni/kimi-dock",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check": "npm run typecheck && npm run lint && npm run build",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "rebuild": "rm -rf out && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "release": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "test:e2e:migration": "npm run build && node scripts/e2e-migration.mjs",
    "test:unit": "rm -rf .tmp/unit-build && tsc -p test/tsconfig.unit.json && echo '{\"type\":\"module\"}' > .tmp/unit-build/package.json && node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@iarna/rtf-to-html": "^1.1.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright": "^1.65.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "build": {
    "appId": "io.github.heni.kimi-dock",
    "productName": "Kimi Dock",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "executableName": "kimi-dock",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "resources/icon.png",
      "executableName": "kimi-dock",
      "maintainer": "heni <eugene.krokhalev@gmail.com>",
      "category": "Utility;Network",
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Kimi Dock",
          "Comment": "Desktop dock for Kimi AI (Kimi Code Plan)",
          "Categories": "Utility;Network;",
          "StartupWMClass": "kimi-dock"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ],
      "fpm": [
        "--deb-compression",
        "xz"
      ],
      "afterInstall": "packaging/deb/postinst",
      "afterRemove": "packaging/deb/prerm"
    },
    "extraResources": [
      {
        "from": "packaging/apparmor/kimi-dock",
        "to": "apparmor/kimi-dock"
      }
    ]
  }
}
