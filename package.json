{
  "name": "kimi-desktop",
  "version": "3.0.0",
  "description": "Unofficial desktop client for Kimi AI with offline capabilities",
  "main": "./dist/main/index.js",
  "author": "Virusilvester",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "electron-vite build --config electron.vite.config.ts --outDir dist/main -m main",
    "build:preload": "electron-vite build --config electron.vite.config.ts --outDir dist/preload -m preload",
    "build:renderer": "electron-vite build --config electron.vite.config.ts --outDir dist/renderer -m renderer",
    "release": "electron-builder --publish always",
    "release:win": "electron-builder --win --publish always",
    "release:linux": "electron-builder --linux --publish always"
  },
  "build": {
    "appId": "com.kimi.desktop",
    "productName": "Kimi Desktop",
    "copyright": "Copyright © 2026 Virusilvester",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "resources/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Virusilvester",
      "repo": "kimi-desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Virusilvester",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "Virusilvester",
      "vendor": "Virusilvester",
      "synopsis": "Unofficial desktop client for Kimi AI",
      "description": "Kimi Desktop is an unofficial desktop wrapper for Kimi AI with offline capabilities and conversation management."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "plugs": [
        "default",
        "home",
        "network",
        "removable-media"
      ]
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
